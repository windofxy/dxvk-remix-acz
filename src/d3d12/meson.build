d3d12_proxy_src = files(
  'acz_camera_hook.cpp',
  'acz_camera_hook.h',
  'd3d12_command_queue_trace.cpp',
  'd3d12_command_queue_trace.h',
  'd3d12_command_list_trace.cpp',
  'd3d12_command_list_trace.h',
  'd3d12_device_extension_trace.cpp',
  'd3d12_device_extension_trace.h',
  'd3d12_device_raw_trace.cpp',
  'd3d12_device_raw_trace.h',
  'd3d12_command_queue_proxy.cpp',
  'd3d12_command_queue_proxy.h',
  'd3d12_device_proxy.cpp',
  'd3d12_device_proxy.h',
  'd3d12_runtime_adapter.cpp',
  'd3d12_runtime_adapter.h',
  'd3d12_native_backend.cpp',
  'd3d12_native_backend.h',
  'd3d12_resource_registry.cpp',
  'd3d12_resource_registry.h',
  'd3d12_geometry_bridge.cpp',
  'd3d12_geometry_bridge.h',
  'd3d12_proxy.cpp',
)

shared_library('d3d12', d3d12_proxy_src,
  name_prefix         : '',
  link_with           : [ util_lib, spirv_lib, usd_plugins ],
  dependencies        : [ dxvk_dep ],
  link_args           : [ '/IGNORE:4099' ],
  include_directories : [
    dxvk_include_path,
    dxvk_shader_include_path,
    usd_include_paths,
    rtxdi_include_path,
    rtxcr_include_path,
    submodules_include_path,
    remix_api_include_path,
  ],
  vs_module_defs      : 'd3d12.def',
  install             : true,
  override_options    : ['cpp_std='+dxvk_cpp_std])
